# Copy this file to .env (`cp .env.example .env`). It is only a SAMPLE - never put real secrets in this file.
#
# The three EMPTY values below are asked for by the ORBIT setup screen the first time you open the app; the app then
# saves them into your own (git-ignored) .env. Every computer/user therefore gets its own key and its own database.
JWT_SECRET=
DB_USERNAME=
DB_PASSWORD=

# Defaults - normally leave as they are
DB_NAME=orbit
DB_PORT=5433

# Folders / drives ORBIT may open. ORBIT runs in Docker, so it can only see what is listed here (read + write: it
# creates project folders and runs `git init` there). Up to 8. Use forward slashes. Leave the rest empty.
#   Windows:  ORBIT_MOUNT_1=E:/        (a whole drive)      ORBIT_MOUNT_2=D:/Work     (just one folder)
#   macOS:    ORBIT_MOUNT_1=/Users/you/code
#   Linux:    ORBIT_MOUNT_1=/home/you/code                  ORBIT_MOUNT_2=/mnt/data
# Prefer your project drives/folders over a system drive (C:/ or /): ORBIT can read and change everything below them.
# Nothing listed = the ./projects folder next to this file. (ORBIT_PROJECTS_DIR from older versions still works as slot 1.)
ORBIT_MOUNT_1=
ORBIT_MOUNT_2=
ORBIT_MOUNT_3=
ORBIT_MOUNT_4=
ORBIT_MOUNT_5=
ORBIT_MOUNT_6=
ORBIT_MOUNT_7=
ORBIT_MOUNT_8=
